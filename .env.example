# Supabase > Project Settings > Database > Connection string
# Runtime connection: use the Session pooler (port 5432) or Transaction pooler (port 6543).
# For Prisma, prefer Session pooler for normal runtime if deploying on a server; use Transaction pooler only if configured for prepared statements.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public"

# Direct database connection for Prisma migrations (or Supabase Session pooler if IPv6/network restrictions apply).
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=public"

# Generate a unique random secret of at least 32 characters. Never commit real secrets.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
